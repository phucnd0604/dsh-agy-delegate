{
  "name": "dsh-agy-delegate",
  "version": "0.1.0",
  "description": "dsh plugin: delegate a brief to the Antigravity CLI (agy) as a background task, with a floating GUI widget showing live thinking, answer and tool calls",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "antigravity",
    "agy",
    "delegate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
