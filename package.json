{
  "name": "dsh-delegate",
  "version": "0.2.0",
  "description": "dsh plugin: delegate a brief to a coding-agent CLI as a background task, with a floating GUI widget showing live thinking, answer and tool calls",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "antigravity",
    "agy",
    "delegate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucnd0604/dsh-delegate.git"
  },
  "bugs": {
    "url": "https://github.com/phucnd0604/dsh-delegate/issues"
  },
  "homepage": "https://github.com/phucnd0604/dsh-delegate#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/backends/*.test.mjs"
  }
}
